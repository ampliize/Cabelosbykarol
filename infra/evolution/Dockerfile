# Evolution API v2.3.7 + remendo do <status> do Baileys (mensagens presas / atraso em lotes a cada ~50 min).
# Easypanel: serviço da Evolution > Source > Dockerfile > colar este arquivo inteiro > Deploy.
# NÃO use a imagem "latest": ela aponta para a 2.4.0-rc1, versão de teste que exige licença.
# O script embutido é o infra/evolution/patch-baileys-status.cjs (base64 para não depender de outros arquivos).
FROM evoapicloud/evolution-api:v2.3.7
RUN echo '' | base64 -d > /tmp/patch-baileys-status.cjs \
 && node /tmp/patch-baileys-status.cjs \
 && rm /tmp/patch-baileys-status.cjs
